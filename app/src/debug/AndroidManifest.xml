<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Lets adb drive settings for acceptance tests. Never merged into release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".debug.DiagnosticsActivity"
            android:exported="true"
            android:label="GAL diagnostics"
            android:taskAffinity="com.sangar.gal.diagnostics">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".DebugCommandReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.sangar.gal.debug.SET_THRESHOLD" />
                <action android:name="com.sangar.gal.debug.TEST_CARD" />
                <action android:name="com.sangar.gal.debug.PLAYGROUND" />
                <action android:name="com.sangar.gal.debug.DEMO_SCENE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
