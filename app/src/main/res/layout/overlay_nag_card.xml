<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated straight into a WindowManager overlay. Plain views only, no Compose.
     Dark on purpose, so it can never be mistaken for a card inside the app underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_card_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:textColor="@color/tangerine"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="GetALife · 12 min on screen" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mascot"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:src="@drawable/mascot_smug" />

        <TextView
            android:id="@+id/phrase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/cream"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Your screen will still be here. Probably. Go look at a tree." />
    </LinearLayout>

    <!-- Custom outlined buttons on purpose; the borderless button bar style would hide them. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/snooze"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/overlay_button_secondary"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:text="@string/overlay_snooze"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="15sp" />

        <Button
            android:id="@+id/fine"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/overlay_button_primary"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:text="@string/overlay_fine"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shrinks to nothing over the card's lifetime, so the timeout is never a surprise. -->
    <View
        android:id="@+id/timerBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/overlay_timer_bar" />
</LinearLayout>
